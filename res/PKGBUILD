pkgname=ultrarustdesk
pkgver=1.5.1
pkgrel=0
epoch=
pkgdesc="Ultra RustDesk - low-latency remote desktop (fork of RustDesk)"
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/ultrarustdesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/ultrarustdesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/ultrarustdesk/ultrarustdesk usr/bin/ultrarustdesk && popd
  install -Dm 644 $HBB/res/ultrarustdesk.service -t "${pkgdir}/usr/share/ultrarustdesk/files"
  install -Dm 644 $HBB/res/ultrarustdesk.desktop -t "${pkgdir}/usr/share/ultrarustdesk/files"
  install -Dm 644 $HBB/res/ultrarustdesk-link.desktop -t "${pkgdir}/usr/share/ultrarustdesk/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/ultrarustdesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/ultrarustdesk.svg"
}
