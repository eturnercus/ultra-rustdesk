#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/ultrarustdesk

		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop ultrarustdesk || true
			systemctl disable ultrarustdesk || true
			rm /etc/systemd/system/ultrarustdesk.service /usr/lib/systemd/system/ultrarustdesk.service || true
			rm /usr/lib/systemd/user/ultrarustdesk.service >/dev/null 2>&1 || true
		fi
        ;;
esac

exit 0
