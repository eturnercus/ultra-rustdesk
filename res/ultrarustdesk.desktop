[Desktop Entry]
Name=Ultra RustDesk
GenericName=Remote Desktop
Comment=Remote Desktop
Exec=ultrarustdesk %u
Icon=ultrarustdesk
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;linux;dart;rust;remote-control;p2p;rdp;remote-desktop;vnc;quic;
Actions=new-window;
StartupWMClass=ultrarustdesk

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=ultrarustdesk %u
