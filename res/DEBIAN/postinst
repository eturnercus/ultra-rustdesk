#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/ultrarustdesk/ultrarustdesk /usr/bin/ultrarustdesk

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/ultrarustdesk.service ]; then
			rm -f /etc/systemd/system/ultrarustdesk.service /usr/lib/systemd/system/ultrarustdesk.service /usr/lib/systemd/user/ultrarustdesk.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/ultrarustdesk/files/systemd/ultrarustdesk.service /usr/lib/systemd/system/ultrarustdesk.service
		# try fix error in Ubuntu 18.04
		# Executable path is not absolute: pkill -f "ultrarustdesk --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/ultrarustdesk.service
		fi
		systemctl daemon-reload
		systemctl enable ultrarustdesk
		systemctl start ultrarustdesk
	fi
	# Ultra RustDesk: desktops cache icons by name; show the new one at once.
	gtk-update-icon-cache -f -t -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
	update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi
